# Maintainer: Socheat Rotanak <socheatrotanak@gmail.com>

pkgname=oma-own-note
pkgver=0.1.0
pkgrel=1
pkgdesc='Dead-simple Markdown writing app built with Qt Quick'
arch=('x86_64')
url='https://github.com/JustNak/Oma-Own-Note'
license=('MIT')
install='oma-own-note.install'
depends=('qt6-base' 'qt6-declarative' 'xdg-desktop-portal')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  /usr/bin/install -Dm755 build/oma-own-note "$pkgdir/usr/bin/oma-own-note"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
  /usr/bin/install -Dm644 "$startdir/oma-own-note.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/oma-own-note.svg"
  /usr/bin/install -Dm644 "$startdir/oma-own-note.desktop" "$pkgdir/usr/share/applications/oma-own-note.desktop"
}
